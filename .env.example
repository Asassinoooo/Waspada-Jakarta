# Backend-only local synthetic model test. Keep real values in ignored .env.local.
# The gateway base may end at the host/root or /v1. Do not use VITE_ variables.
NINEROUTER_URL=
NINEROUTER_KEY=

# Optional non-secret weekly selection label. Default is explicitly a test-run tag.
# NINEROUTER_CURATION_EPOCH=curation-week-42

# Local private pipeline only: 15-minute real request default, range 1000..900000 ms.
# Historical 25-second states must be reopened with their original policy.
# NINEROUTER_TIMEOUT_MS=900000
