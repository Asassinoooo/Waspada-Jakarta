# Backend-only local synthetic model test. Keep real values in ignored .env.local.
# The gateway base may end at the host/root or /v1. Do not use VITE_ variables.
NINEROUTER_URL=
NINEROUTER_KEY=

# Optional non-secret weekly selection label. Default is explicitly a test-run tag.
# NINEROUTER_CURATION_EPOCH=curation-week-42

# Local private pipeline only: 15-minute real request default, range 1000..900000 ms.
# Historical 25-second states must be reopened with their original policy.
# NINEROUTER_TIMEOUT_MS=900000

# Operator-seeded first administrator for `serve:live` and `npm run accounts:seed-admin`.
# Set both in .env.local (never commit values). The password is never printed.
# WASPADA_ADMIN_USERNAME=
# WASPADA_ADMIN_PASSWORD=

# Shared secret for webhook ingest (`x-service-key`). Unset means the route answers 503.
# WEBHOOK_SERVICE_KEY=

# HOSTED-12: AI provider. ninerouter (default, local dev) or google_ai_studio (hosted). Names only.
# AI_PROVIDER=
# GOOGLE_AI_API_KEY=            secret; never commit a value
# GOOGLE_AI_CHAT_MODEL=         default gemini-3.5-flash-lite
# GOOGLE_AI_FALLBACK_CHAT_MODEL= default gemini-3.1-flash-lite
# GOOGLE_AI_EMBEDDING_MODEL=    default gemini-embedding-2 (768 dimensions)
# GOOGLE_AI_CHAT_RPM=           set from the AI Studio rate-limit page; unset means no RPM pacing
# GOOGLE_AI_EMBED_RPM=          same as above for embeddings
# GOOGLE_AI_TIMEOUT_MS=         default 60000
