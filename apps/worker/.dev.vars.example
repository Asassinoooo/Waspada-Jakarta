# Copy locally to .dev.vars only after preparing a dedicated auth DB role.
# Disabled by default. Do not put these values in frontend or Flutter builds.
AUTH_ENABLED=false
AUTH_APP_ORIGIN=https://waspada.example
# AUTH_HYPERDRIVE is a Worker binding for the dedicated auth DB connection.
# Do not place a production DB password or provider token in this template.
# Shared secrets for machine routes. Unset means those routes answer 503.
# INTERNAL_SERVICE_KEY=REPLACE_LOCALLY
# WEBHOOK_SERVICE_KEY=REPLACE_LOCALLY
# Automatic publication source-permission check (ADR-061). Unset or any other value means `required`.
# Only the local serve:live server sets `local_relaxed`, and it is never set for hosted deployments.
# AUTO_PUBLISH_SOURCE_PERMISSION=required
# Hours before an undecided proposal expires (REVIEW-EXPIRY-01, ADR-062). Integer 1..720. Unset or invalid means 48.
# PROPOSAL_REVIEW_TTL_HOURS=48
# WJ-INT-02A live triage transport. Secrets only via dashboard/wrangler
# secret/.dev.vars — never in wrangler.toml. Local node tooling falls back
# to the same names in process env (see .env.local).
# NINEROUTER_URL=https://your-ninerouter-host:9090/v1
# NINEROUTER_KEY=REPLACE_LOCALLY
# NINEROUTER_CHAT_MODEL=Waspada-Jakarta
