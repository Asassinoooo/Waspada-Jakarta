    {
      "id": "bnpb-juklak-7-2023",
      "kind": "national_disaster_data_standard",
      "publisher": "BNPB",
      "url": "https://data.bnpb.go.id/dataset/juklak-standar-data-kejadian-dan-dampak-bencana",
      "supports": [
        "National event/damage data standard as a reference for expanding disaster terminology."
      ],
      "limitations": "Not used as a complete list of the phrases below; supplemental aliases are curated."
    },
    {
      "id": "bmkg-early-warning",
      "kind": "official_weather_alert_reference",
      "publisher": "BMKG",
      "url": "https://www.bmkg.go.id/peringatan-dini",
      "supports": [
        "Weather early-warning and hazard-advisory terminology."
      ],
      "limitations": "Forecast/advisory terms are kept separate from occurred incidents."
    },
    {
      "id": "legacy-wj-rss-keywords",
      "kind": "repository_legacy_terms",
      "publisher": "Waspada Jakarta repository",
