      "supports": [
        "Kebakaran",
        "Pohon tumbang",
        "Jalan tergenang",
        "Banjir",
        "Tanah longsor",
        "Angin kencang",
        "Kejadian lainnya"
      ],
      "limitations": "A year-specific list of BPBD reported event labels, not a complete taxonomy for all city-safety, transport, crime, health, or utility incidents."
    },
    {
      "id": "bpbd-dki-open-data-dashboard",
      "kind": "official_jakarta_dashboard",
      "publisher": "BPBD DKI Jakarta",
