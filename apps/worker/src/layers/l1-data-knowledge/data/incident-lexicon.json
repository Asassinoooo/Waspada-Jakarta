    {
      "id": "bpbd-dki-2025-infographic",
      "kind": "official_jakarta_annual_reference",
      "publisher": "BPBD DKI Jakarta",
      "url": "https://bpbd.jakarta.go.id/perpustakaan/SDJka2V4R3cwZnd0OG9BSVk5WkFGUT09/infografis-kejadian-bencana-2025",
