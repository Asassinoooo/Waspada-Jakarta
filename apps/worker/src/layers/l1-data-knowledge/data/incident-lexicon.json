  "matchingPolicy": {
    "normalizationVersion": "nfkc-id-lower-space-v1",
    "normalization": [
      "Unicode NFKC",
      "lowercase",
      "replace punctuation with spaces but preserve token order",
      "collapse whitespace",
      "tokenize once"
    ],
    "matchMethod": "Exact token sequence / phrase matching with token boundaries; do not use substring includes. Precompile a token index once when loading this JSON.",
    "signalStrength": [
      "strong",
      "supporting",
      "alert_only",
      "context_only"
    ],
    "strongTermRequirement": "Only a strong term from eventGroups can provide the incident side of a candidate. supporting/globalSupportingTerms/alertSignals never independently satisfy it.",
    "alertHandling": "Alert-only signals without an occurred-event strong term produce at most ambiguous, not candidate.",
    "negativeContext": "Forecast, planned activity, historical retrospectives, hypothetical examples, and quoted old incidents need additional context. Do not apply one global negation regex that incorrectly suppresses actual events in the same sentence.",
    "candidateRule": "A candidate requires (a) a specific Jakarta kelurahan or kecamatan match, not merely Jakarta/province/city, and (b) at least one strong occurred-incident phrase. Scene-role must not be known non-scene; unknown scene role should downgrade to ambiguous unless other clear scene evidence exists.",
    "ambiguousRule": "Use ambiguous when only a broad/city/province location exists, only an incident signal exists, only alert/supporting terms exist, a locality alias is context-required, or location role cannot be determined.",
    "lowSignalRule": "Use low_signal when neither a Jakarta-specific location nor a strong incident/alert/supporting signal is present. Low signal must not be silently deleted.",
    "primaryCategoryPolicy": "primaryCategoryHint is a non-binding suggestion only. The matcher must not set final primaryCategory or incidentType. Existing semantic triage and human review remain authoritative.",
    "idPolicy": "eventGroups[].id is a JSON lexicon key, not a TypeScript enum, database enum, official primaryCategory, or closed incidentType list."
  },
