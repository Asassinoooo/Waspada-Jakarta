@startuml fig-3-7-component
!include theme/waspada-report.theme.puml
top to bottom direction

package "Front ends" as FE {
  component "apps/web\nReact 19: map, detail,\nadmin workspace" as WEB
  component "apps/mobile\nFlutter, public read only" as MOB
}
package "apps/worker (Cloudflare Worker;\nalso runs in-process locally)" as WK {
  component "Public, moderation, accounts\nand pipeline flow APIs" as API
  component "Publication gate (L4)\nproposal-publication.ts\npublication-policy.ts" as GATE
  component "L3 investigation\ncoordinator and ledger\nnot wired" as L3
}
package "apps/intelligence (Node)" as INT {
  component "Job runner\njob-runner.ts" as JOB
  component "Mastra workflow\nand agents" as WF
  component "NineRouter adapter" as NRA
}
database "apps/db\nstores and migrations 001-047" as DB
rectangle "External: feeds, NineRouter gateway" as EXT

WEB --> API
MOB --> API
API --> GATE
JOB --> GATE : POST proposal
JOB --> WF
WF --> NRA
NRA --> EXT : HTTPS
GATE --> DB
API --> DB
JOB --> DB
L3 ..> DB : ledger (tests only)
@enduml
