@startuml fig-3-4-sequence
!include theme/waspada-report.theme.puml
participant "Triage (L1)" as T
participant "Job runner\n(apps/intelligence)" as J
participant "NineRouter" as NR
database "PostgreSQL" as DB
participant "Worker API\n(L4 gate)" as W
actor "Browser" as B

T -> DB : revision, chunks, ai_jobs (pending)
J -> DB : lease job
J -> NR : interpret, embed, correlate
J -> DB : persist incident and proposal
J -> W : POST /api/v1/internal/proposals
W -> DB : read proposal
alt no discrepancy and all checks pass
  W -> DB : decision, version, claims (one transaction)
  W -> W : update PublicReadModel
else discrepancy or failed check
  W --> J : queued for moderator
end
B -> W : GET /api/v1/events
W --> B : published versions only
@enduml
