@startuml fig-3-2-use-case
!include theme/waspada-report.theme.puml
left to right direction

actor "Public visitor" as V
actor "Registered user\n(role: user)" as U
actor "Moderator" as M
actor "Administrator" as A
actor "System agents" as S
actor "External sources\nand model gateway" as E

rectangle "Waspada Jakarta" {
  usecase "Browse map, list\nand updates" as UC1
  usecase "Open incident detail,\nevidence and freshness" as UC2
  usecase "Register, log in,\nset local interests" as UC3
  usecase "Review evidence queue\nand publish or reject" as UC4
  usecase "View pipeline flow\nand 3D embeddings" as UC5
  usecase "Manage accounts and\nview source data (demo)" as UC6
  usecase "Auto-publish without\ndiscrepancy; expire after 48 h" as UC7
  usecase "Acquire, triage,\ninterpret and correlate" as UC8
}

V --> UC1
V --> UC2
U --|> V
U --> UC3
M --|> U
M --> UC4
M --> UC5
A --|> M
A --> UC6
S --> UC7
S --> UC8
E --> UC8
@enduml
