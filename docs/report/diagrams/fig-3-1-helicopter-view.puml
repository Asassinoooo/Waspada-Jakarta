@startuml fig-3-1-helicopter-view
!include theme/waspada-report.theme.puml
top to bottom direction

rectangle "CLIENTS\nWeb app (React)\nreaders, incident detail, admin" as WEB
rectangle "CLIENTS\nAndroid app (Flutter)\npublic read only" as APP
rectangle "SERVICES (local live mode)\nWorker API\n/api/v1, moderation, auth" as API
rectangle "SERVICES\nIntelligence job runner\napps/intelligence (Mastra)" as JOB
rectangle "SERVICES\nIngestion pollers (60 s)\nL1 triage gate" as ING
rectangle "SERVICES\nPublication gate (L4)\nauto-publish or moderator queue" as GATE
rectangle "EXTERNAL\nPetaBencana, BMKG CAP,\n14 RSS feeds" as SRC
rectangle "EXTERNAL\nNineRouter gateway\nchat and embedding" as NR
database "STORAGE\nPostgreSQL / PGlite\nwaspada.* schema" as DB

WEB --> API
APP --> API : public GET only
API --> GATE
JOB --> GATE : POST proposal
SRC --> ING : poll or push
ING --> DB : reports, jobs
JOB --> NR : interpret, embed
JOB --> DB : lease, write
GATE --> DB : decisions, publish
API --> DB : read
@enduml
