@startuml fig-3-5-class
!include theme/waspada-report.theme.puml
hide empty members

class Source <<source_registry>> {
  source_id
  access_method
  approval_status
}
class ReportRevision <<report_revisions>> {
  report_revision_id
  content_hash (immutable)
}
class EvidenceChunk <<evidence_chunks>> {
  chunk_id, status
}
class EventProposal <<event_proposals>> {
  proposal_id
  correlation_relationship
  has_discrepancy
}
class ProposalClaim <<proposal_claims>> {
  evidence_label
  support_assessment
}
class PublicationDecision <<publication_decisions>> {
  disposition: publish | reject | expire
  actor_kind, actor_id
}

Source "1" -- "0..*" ReportRevision
ReportRevision "1" -- "0..*" EvidenceChunk
ReportRevision "1" -- "0..*" EventProposal
EventProposal "1" *-- "1..*" ProposalClaim
EventProposal "1" -- "0..1" PublicationDecision
@enduml
