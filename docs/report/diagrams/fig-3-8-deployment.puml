@startuml fig-3-8-deployment
!include theme/waspada-report.theme.puml
top to bottom direction

node "Browser\ndesktop or phone" as BR
rectangle "IMPLEMENTED\nWorker API in one Node process\n:8787, serves apps/web/dist" as WAPI
rectangle "IMPLEMENTED\nPollers (60 s) and\njob runner" as POLL
database "PGlite file\n.data/live-db" as PG
rectangle "External providers\nPetaBencana, BMKG, 14 RSS feeds,\nNineRouter gateway" as SRC
rectangle "PLANNED / GATED\nCloudflare Workers" as CF #F2F6F4;line.dashed
database "PLANNED / GATED\nNeon PostgreSQL" as NEON #F2F6F4;line.dashed

BR --> WAPI : HTTP
WAPI --> PG : reads, writes
POLL --> PG : leases, writes
POLL --> SRC : poll, chat, embedding
BR ..> CF : planned
CF ..> NEON : planned
@enduml
