@startuml fig-1-1-five-layer-architecture
!include theme/waspada-report.theme.puml
top to bottom direction

package "L1 Data and knowledge" as L1 {
  together {
    rectangle "Acquisition\n14 RSS feeds, PetaBencana,\nBMKG CAP, webhooks" as ACQ
    rectangle "Triage gate\nprefilter, AI triage,\npermission evidence" as TRI
  }
  rectangle "Report revisions, evidence chunks,\nai_jobs queue" as REV
}
package "Intelligence service (apps/intelligence)" as INT {
  rectangle "Interpret, embed, retrieve,\ncorrelate (Mastra workflow)" as WF
}
package "L4 Application integration" as L4 {
  together {
    rectangle "Publication gate\nassessAutoPublication (ADR-061)" as GATE
    rectangle "L5 telemetry and audit" as TEL
  }
  rectangle "Public API, moderation API,\npipeline flow, PublicReadModel" as API
}
package "Not on the live path" as SIDE {
  together {
    rectangle "L2 model adapter\nNineRouter, retrieval" as L2
    rectangle "L3 investigation\nimplemented, not connected" as L3
  }
}
rectangle "Readers\n#peta web map, Android (public read)" as RD

ACQ --> TRI
TRI --> REV
REV --> WF : ai_jobs
WF --> GATE : proposal, awaiting decision
GATE --> API
API --> RD : published versions only
L2 ..> WF : not wired
L3 ..> WF : not wired
@enduml
